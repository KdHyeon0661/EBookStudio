<UserControl x:Class="EBookStudio.Views.BookDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:EBookStudio.Helpers"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1150">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                          Direction="270" Color="#B8BEC8" Opacity="0.22"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Background" Value="#007AFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="40,26,40,42" MaxWidth="1080" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding BackCommand}" Content="←  보관함"
                            Background="Transparent" BorderThickness="0" Foreground="#555"
                            FontSize="14" Padding="0" Cursor="Hand"/>
                    <StackPanel Grid.Column="1" Margin="24,0">
                        <TextBlock Text="책 상세" FontSize="25" FontWeight="Bold" Foreground="#222"/>
                        <TextBlock Text="로컬 독서 정보와 서버 처리 기록" FontSize="13"
                                   Foreground="#888" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="새로고침"
                            Height="36" Padding="16,0" Background="White" Foreground="#007AFF"
                            BorderBrush="#B9D9FF" BorderThickness="1" Cursor="Hand"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="310" CornerRadius="10" Background="#EEF1F5" ClipToBounds="True">
                                <Image Source="{Binding Book.CoverUrl, TargetNullValue={x:Null}}"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Book.Title}" FontSize="21" FontWeight="Bold"
                                       Foreground="#222" TextWrapping="Wrap" Margin="0,18,0,0"/>
                            <TextBlock Text="{Binding Book.Author, StringFormat='저자  {0}'}"
                                       Foreground="#666" FontSize="14" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding Book.CreatedAt, StringFormat='추가일  {0:yyyy.MM.dd}'}"
                                       Foreground="#999" FontSize="12" Margin="0,4,0,0"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Value="{Binding Book.ProgressValue}"
                                             Maximum="100" Height="7" VerticalAlignment="Center"
                                             Foreground="#007AFF" Background="#E9ECEF" BorderThickness="0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Book.ProgressText}"
                                           Foreground="#007AFF" FontWeight="Bold" Margin="10,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,13,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="서버 상태" Foreground="#777"/>
                                <TextBlock Grid.Column="1" Text="{Binding BookServerStatus}"
                                           Foreground="#333" FontWeight="SemiBold"/>
                            </Grid>
                            <Button Command="{Binding ReadCommand}" Content="읽기 시작"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="#EAF4FF" BorderBrush="#C5E0FF" BorderThickness="1"
                                CornerRadius="10" Padding="15,11" Margin="0,0,0,18"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ServerStatusMessage}" Foreground="#315B86"
                                       TextWrapping="Wrap" FontSize="13"/>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="처리 이력" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                                    <TextBlock Text="{Binding ProcessingSummary}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#888" FontSize="12"/>
                                </Grid>
                                <TextBlock Text="온라인 분석 기록이 없습니다. 로컬 책 읽기에는 영향이 없습니다."
                                           Foreground="#999" TextWrapping="Wrap" Margin="0,8"
                                           Visibility="{Binding HasProcessingRuns, Converter={StaticResource InverseBoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding ProcessingRuns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8EAED" BorderThickness="0,1,0,0" Padding="0,13">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ProcessType}" FontWeight="SemiBold"
                                                                       Foreground="#333" FontSize="14"/>
                                                            <TextBlock Text="{Binding AttemptText}" Foreground="#999"
                                                                       FontSize="12" Margin="10,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                                   HorizontalAlignment="Right" FontWeight="Bold"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding ArtifactSummary}"
                                                               Foreground="#666" FontSize="12" Margin="0,7,0,0"
                                                               TextWrapping="Wrap"/>
                                                    <Grid Grid.Row="2" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding ModelVersion}" Foreground="#999" FontSize="11"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding ErrorCode}" Foreground="#DC3545"
                                                                       FontSize="11" Margin="0,0,12,0"/>
                                                            <TextBlock Text="{Binding TimeText}" Foreground="#999" FontSize="11"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="음악 매핑" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                                    <TextBlock Text="{Binding MusicSummary}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#888" FontSize="12"/>
                                </Grid>
                                <TextBlock Text="서버에 등록된 세그먼트 음악이 없습니다."
                                           Foreground="#999" Margin="0,8"
                                           Visibility="{Binding HasMusicTracks, Converter={StaticResource InverseBoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding MusicTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8EAED" BorderThickness="0,1,0,0" Padding="0,13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SegmentKey}" FontWeight="SemiBold"
                                                                   Foreground="#333"/>
                                                        <TextBlock Text="{Binding GenreAndTempo}" Foreground="#666"
                                                                   FontSize="12" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding Model}" Foreground="#999"
                                                                   FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FileName}" Foreground="#999"
                                                                   FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding BindingType}" Foreground="{Binding BindingColor}"
                                                                   FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding ReuseText}" Foreground="#888"
                                                                   FontSize="11" Margin="0,7,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.RowSpan="3" Background="#66FFFFFF"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="160" Height="7"
                                     Foreground="#007AFF" BorderThickness="0"/>
                        <TextBlock Text="서버 정보를 불러오는 중..." Foreground="#555"
                                   Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
